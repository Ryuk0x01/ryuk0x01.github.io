---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}

const {
	entry,
	title,
	url,
	published,
	tags = [],
	category,
	image,
	description,
	style,
} = Astro.props;

const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const { remarkPluginFrontmatter } = await entry.render();
---

<!-- Card Container with Default Fuwari Colors -->
<div class:list={["card-base flex flex-col h-full w-full rounded-2xl overflow-hidden relative shadow-md hover:shadow-lg transition duration-300", className]} style={style}>
    
    <!-- 1. Fixed Height Cover Image -->
    <a href={url} aria-label={title} class="group w-full h-44 relative overflow-hidden block flex-shrink-0 bg-black/5 dark:bg-white/5">
        {hasCover ? (
            <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out">
            </ImageWrapper>
        ) : (
            <div class="w-full h-full flex items-center justify-center text-black/20 dark:text-white/20">
                <Icon name="material-symbols:image-outline" class="text-4xl" />
            </div>
        )}
    </a>

    <!-- 2. Content Block -->
    <div class="p-4 flex flex-col flex-1 justify-between gap-2">
        <div>
            <!-- Title -->
            <a href={url}
               class="transition group w-full block font-bold text-base text-black/90 dark:text-white/90 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] line-clamp-2 h-[2.75rem] leading-snug mb-1">
                {title}
            </a>

            <!-- Metadata (Date & Category) -->
            <div class="flex items-center gap-3 text-[11px] text-black/50 dark:text-white/50 mb-2 font-medium">
                <div class="flex items-center gap-1">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xs"></Icon>
                    <span>{formatDateToYYYYMMDD(published)}</span>
                </div>
                {category && (
                    <div class="flex items-center gap-1">
                        <Icon name="material-symbols:book-2-outline-rounded" class="text-xs"></Icon>
                        <a href={getCategoryUrl(category)} class="hover:text-[var(--primary)] transition">
                            {category}
                        </a>
                    </div>
                )}
            </div>

            <!-- Description -->
            <p class="text-black/60 dark:text-white/60 text-xs line-clamp-2 h-[2.5rem] leading-relaxed overflow-hidden">
                { description || remarkPluginFrontmatter.excerpt }
            </p>
        </div>

        <!-- 3. Tags Container with Default Badge Style -->
        <div class="flex flex-wrap gap-1.5 pt-2 mt-auto border-t border-black/5 dark:border-white/5 h-[2.25rem] overflow-hidden items-center">
            {tags && tags.length > 0 ? (
                tags.map((tag) => (
                    <a href={getTagUrl(tag)}
                       class="text-[11px] font-medium text-black/70 dark:text-white/70 bg-black/5 dark:bg-white/10 hover:bg-[var(--primary)] hover:text-white dark:hover:bg-[var(--primary)] dark:hover:text-black px-2 py-0.5 rounded transition whitespace-nowrap">
                        #{tag.trim()}
                    </a>
                ))
            ) : (
                <span class="text-[10px] text-black/30 dark:text-white/30">#NoTags</span>
            )}
        </div>
    </div>
</div>